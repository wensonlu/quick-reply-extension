{
  "name": "quick-reply-extension",
  "displayName": "快捷话术",
  "version": "0.1.0",
  "description": "电商客服快捷话术一键填充工具",
  "author": "工程师",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "typescript": "^6.0.3"
  },
  "manifest": {
    "host_permissions": [],
    "permissions": ["activeTab", "scripting", "storage"],
    "commands": {
      "open-popup": {
        "suggested_key": { "default": "Ctrl+Shift+Space" },
        "description": "打开快捷话术"
      }
    }
  }
}
